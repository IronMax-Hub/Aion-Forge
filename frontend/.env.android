# Phone build (npm run android): there is no backend on the phone, so nothing is saved.
VITE_STORAGE=off
# The phone's GPU is far faster than the desktop's: trace the black hole close-up more finely (rendering/blackHole/quality.ts).
# Medium, as measured on the owner's phone: High fell to 13–18 fps close up (Documents/Black-Hole-Phone-Quality.md)
VITE_BLACK_HOLE_QUALITY=medium
# The close-up's heat and frame-rate readout: "on" shows it, for measuring on the phone
VITE_BLACK_HOLE_STATS=off
