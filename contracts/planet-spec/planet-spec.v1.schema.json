{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planet Spec, version 1",
  "description": "One planet, as Planet Forge forges it. Generated from planet-forge/src/spec/schema.ts by `npm run schema`; see contracts/planet-spec/README.md. Also required, but not expressible here: each cell's direction is a unit vector and the gas shares add up to 1, both to within 0.001.",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "aion-forge",
        "preset",
        "custom"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "origin": {
      "type": "object",
      "properties": {
        "galaxySeed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "starId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "planetIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rulesVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "galaxySeed",
        "starId",
        "planetIndex",
        "rulesVersion"
      ]
    },
    "star": {
      "type": "object",
      "properties": {
        "temperatureK": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "luminositySolar": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radiusSolar": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "temperatureK",
        "luminositySolar",
        "radiusSolar"
      ]
    },
    "orbit": {
      "type": "object",
      "properties": {
        "distanceAU": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "periodYears": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "distanceAU",
        "periodYears"
      ]
    },
    "body": {
      "type": "object",
      "properties": {
        "radiusEarth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "massEarth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gravityG": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotationHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tidallyLocked": {
          "type": "boolean"
        },
        "axialTiltDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        }
      },
      "required": [
        "radiusEarth",
        "massEarth",
        "gravityG",
        "rotationHours",
        "tidallyLocked",
        "axialTiltDeg"
      ]
    },
    "air": {
      "type": "object",
      "properties": {
        "pressureBar": {
          "type": "number",
          "minimum": 0
        },
        "gases": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "N2",
              "O2",
              "O3",
              "CO2",
              "H2O",
              "CH4",
              "N2O",
              "NO2",
              "CFC11",
              "CFC12",
              "H2",
              "He",
              "NH3",
              "CO"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "cloudCover": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "pressureBar",
        "gases",
        "cloudCover"
      ]
    },
    "surface": {
      "type": "object",
      "properties": {
        "cells": {
          "minItems": 12,
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  }
                ]
              }
            ],
            "items": false,
            "minItems": 7,
            "maxItems": 7
          }
        },
        "seaLevelKm": {
          "type": "number"
        },
        "freezingK": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "boilingK": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "steam": {
          "type": "boolean"
        }
      },
      "required": [
        "cells",
        "seaLevelKm",
        "freezingK",
        "boilingK",
        "steam"
      ]
    },
    "groundCover": {
      "type": "object",
      "properties": {
        "cover": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "colourLinear": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "cover",
        "colourLinear"
      ]
    },
    "landing": {
      "type": "object",
      "properties": {
        "latitudeDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitudeDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "subsolar": {
          "type": "object",
          "properties": {
            "latitudeDeg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitudeDeg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitudeDeg",
            "longitudeDeg"
          ]
        },
        "observed": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "land",
                "water",
                "ice"
              ]
            },
            "heightKm": {
              "type": "number"
            },
            "vegetated": {
              "type": "boolean"
            },
            "colourLinear": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "kind",
            "heightKm",
            "vegetated",
            "colourLinear"
          ]
        }
      },
      "required": [
        "latitudeDeg",
        "longitudeDeg",
        "subsolar"
      ]
    }
  },
  "required": [
    "specVersion",
    "source",
    "name",
    "seed",
    "star",
    "orbit",
    "body",
    "air",
    "surface"
  ]
}
